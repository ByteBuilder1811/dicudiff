# Copy to .env (backend reads it from the repo root or backend/). Every value below is the default.
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/docudiff.db        # any SQLAlchemy URL; see docs/ARCHITECTURE.md for PostgreSQL

MAX_UPLOAD_MB=25
MAX_PAGES=400
RETENTION_DAYS=0              # 0 = keep until deleted; N = purge documents older than N days at startup
COMPARISON_TIMEOUT_S=300
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OCR for scanned PDFs (requires the Tesseract binary: brew install tesseract / apt install tesseract-ocr)
OCR_ENABLED=false
OCR_LANGUAGE=eng

# Local embeddings: auto | sentence-transformers | hashing (lexical, for tests) | none
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ALLOW_MODEL_DOWNLOAD=false    # keep false; run `python scripts/download_models.py` once instead
RERANK_MODEL=                 # optional cross-encoder, e.g. cross-encoder/ms-marco-MiniLM-L-6-v2

# Local LLM through Ollama (never auto-pulled). 3B fits ~4 GB RAM; 8B models need 8+ GB free and are slow on 8 GB machines.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_S=180
